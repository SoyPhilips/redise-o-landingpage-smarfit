---
import { sedes } from '../data/sedes';
---

<div class="sedes-map-layout">
  <div id="sedes-map" class="sedes-map" aria-label="Mapa de sedes Smart Fit en Colombia"></div>
  <aside class="sedes-panel" aria-label="Listado de sedes">
    <p class="sedes-panel-count" id="sedes-count">{sedes.length} sedes en el mapa</p>
    <p id="sedes-empty" class="sedes-empty" hidden>
      No encontramos sedes con ese criterio. Prueba con otra ciudad o barrio.
    </p>
    <ul id="sedes-list" class="sedes-list">
      {
        sedes.map((sede) => (
          <li class="sedes-list-item" data-sede-id={sede.id}>
            <strong>{sede.name}</strong>
            <span>{sede.city}</span>
            <p>{sede.address}</p>
            {sede.url && (
              <a href={sede.url} target="_blank" rel="noopener noreferrer">
                Ver sede
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </aside>
</div>

<script>
  import { initSedesMap } from '../scripts/sedes-map';

  initSedesMap();
</script>

<style>
  .sedes-map-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    text-align: left;
  }

  @media (min-width: 992px) {
    .sedes-map-layout {
      grid-template-columns: 1.4fr 1fr;
      align-items: stretch;
    }
  }

  .sedes-map {
    width: 100%;
    height: 420px;
    min-height: 420px;
    border-radius: 8px;
    z-index: 0;
    border: 1px solid #ddd;
    background: #e8e8e8;
  }

  .sedes-map :global(.leaflet-container) {
    height: 100%;
    width: 100%;
    border-radius: 8px;
    font-family: inherit;
  }

  .sedes-panel {
    background: var(--color-light);
    border-radius: 8px;
    padding: 16px;
    max-height: 420px;
    display: flex;
    flex-direction: column;
  }

  .sedes-panel-count {
    font-weight: 800;
    font-size: 0.85rem;
    text-transform: uppercase;
    margin-bottom: 12px;
    color: var(--color-gray);
  }

  .sedes-empty {
    font-size: 0.9rem;
    color: #666;
    margin-bottom: 12px;
    padding: 12px;
    background: #fff;
    border-radius: 4px;
    border: 1px dashed #ccc;
  }

  .sedes-list {
    list-style: none;
    overflow-y: auto;
    flex: 1;
    margin: 0;
    padding: 0;
  }

  .sedes-list-item {
    padding: 12px 0;
    border-bottom: 1px solid #ddd;
    cursor: pointer;
    transition: background 0.2s;
  }

  .sedes-list-item:hover {
    background: rgba(189, 202, 27, 0.12);
  }

  .sedes-list-item strong {
    display: block;
    text-transform: uppercase;
    font-size: 0.95rem;
  }

  .sedes-list-item span {
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
  }

  .sedes-list-item p {
    margin: 6px 0;
    font-size: 0.9rem;
    color: #555;
  }

  .sedes-list-item a {
    font-weight: 800;
    font-size: 0.8rem;
    text-transform: uppercase;
    color: var(--color-dark);
  }

  :global(.sedes-marker) {
    background: transparent;
    border: none;
  }

  :global(.sedes-marker span) {
    display: block;
    width: 28px;
    height: 28px;
    background: #bdca1b;
    border: 3px solid #1a1a1a;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
  }
</style>
