<style>
  /* Urgency Bar */
  .urgency-bar {
    background-color: var(--color-dark);
    color: var(--color-primary);
    text-align: center;
    padding: 10px 0;
    font-weight: 800;
    font-size: 0.9rem;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .urgency-bar .container {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
  }

  /* Header */
  .header {
    padding: 14px 0;
  }
  .header-content {
    display: grid;
    grid-template-columns: minmax(200px, auto) 1fr auto;
    align-items: center;
    gap: 16px 24px;
    min-height: 88px;
  }
  .logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
    line-height: 0;
  }
  .header .logo-header {
    justify-self: start;
    align-self: center;
    height: 88px;
  }
  .header .logo-header img {
    height: 88px;
    width: auto;
    max-width: 260px;
    display: block;
    object-fit: contain;
    object-position: left center;
    mix-blend-mode: lighten;
  }
  .nav-desktop {
    justify-self: center;
  }
  .header-content > .btn {
    justify-self: end;
    white-space: nowrap;
    padding: 14px 28px;
    font-size: 1rem;
  }
  .footer-brand .logo-footer {
    height: 52px;
  }
  .footer-brand .logo-footer img {
    height: 52px;
    width: auto;
    max-width: 160px;
    object-fit: contain;
    object-position: left center;
    mix-blend-mode: lighten;
  }
  #beneficios {
    scroll-margin-top: 100px;
  }
  .nav-desktop ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 18px 22px;
  }
  .nav-desktop a {
    color: var(--color-white);
    text-decoration: none;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.8rem;
    transition: color 0.3s;
  }
  .nav-desktop a:hover {
    color: var(--color-primary);
  }

  /* Hero */
  .hero {
    position: relative;
    padding: 120px 0;
    background-image: url('/hero_bg.png');
    background-size: cover;
    background-position: center;
    color: var(--color-white);
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(26,26,26,0.9) 0%, rgba(26,26,26,0.4) 100%);
  }
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
  }
  .hero-title {
    font-size: 4rem;
    margin-bottom: 20px;
    color: var(--color-primary);
  }
  .hero-subtitle {
    font-size: 1.2rem;
    margin-bottom: 40px;
    font-weight: 500;
  }
  .hero-actions {
    display: flex;
    gap: 20px;
    margin-bottom: 30px;
  }
  .btn-large {
    padding: 20px 40px;
    font-size: 1.2rem;
  }
  .hero-trust {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 0.9rem;
  }

  /* Social Proof */
  .social-proof {
    padding: 20px 0;
  }
  .proof-grid {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }
  .proof-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 0.9rem;
    text-transform: uppercase;
  }

  /* Features */
  .feature-card {
    text-align: center;
    padding: 40px 20px;
    background: var(--color-white);
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    transition: transform 0.3s;
  }
  .feature-card:hover {
    transform: translateY(-10px);
  }
  .feature-icon {
    margin-bottom: 20px;
  }
  .feature-card h3 {
    margin-bottom: 15px;
    font-size: 1.2rem;
  }
  .feature-card p {
    color: #666;
  }

  /* Plans */
  .plan-card {
    background: var(--color-white);
    border: 1px solid #eee;
    border-radius: 8px;
    padding: 40px 30px;
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .plan-black {
    border: 3px solid var(--color-primary);
    background: var(--color-dark);
    color: var(--color-white);
    z-index: 2;
    box-shadow: 0 20px 60px rgba(255,209,0,0.2);
  }
  .plan-badge {
    position: absolute;
    top: -15px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
