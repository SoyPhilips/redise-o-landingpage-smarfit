---
import Layout from '../layouts/Layout.astro';
import SedesMap from '../components/SedesMap.astro';
import logo from '../logo.jpg';
import appImg from '../recursos/app.jpeg';
import smartRumba from '../recursos/smart_rumba.jpeg';
import smartCombat from '../recursos/smart_combat.jpeg';
import smartFuncional from '../recursos/smart_funcional.jpeg';
import smartCycling from '../recursos/smart_cycling.jpeg';
---

<Layout title="Smart Fit Colombia - Gimnasios de alta calidad">
  <!-- 1. BARRA DE URGENCIA -->
  <div class="urgency-bar">
    <div class="container">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
      <span>PRIMER MES GRATIS — Oferta válida hasta el 31 de mayo. ¡Quedan pocos cupos!</span>
    </div>
  </div>

  <!-- 2. HEADER -->
  <header class="header bg-dark">
    <div class="container header-content">
      <a href="#" class="logo logo-header" aria-label="Smart Fit - Inicio">
        <img
          src={logo.src}
          alt="Smart Fit"
          width={logo.width}
          height={logo.height}
          decoding="async"
        />
      </a>
      <nav class="nav-desktop">
        <ul>
          <li><a href="#sedes">Sedes</a></li>
          <li><a href="#planes">Planes</a></li>
          <li><a href="#clases">Clases</a></li>
          <li><a href="#reto">Reto 30 días</a></li>
          <li><a href="#comunidad">Comunidad</a></li>
          <li><a href="#app">App</a></li>
          <li><a href="#beneficios">Beneficios Black</a></li>
        </ul>
      </nav>
      <a href="#planes" class="btn btn-primary">¡Inscríbete ya!</a>
    </div>
  </header>

  <!-- 3. HERO SECTION -->
  <section class="hero">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <h1 class="hero-title">Empieza hoy.<br/>Sin excusas.<br/>Sin pretextos.</h1>
      <p class="hero-subtitle">Más de 2.000 sedes en América Latina &middot; Equipos de última tecnología &middot; Desde $69.900/mes</p>
      
      <div class="hero-actions">
        <a href="#planes" class="btn btn-primary btn-large">Ver planes</a>
        <a href="#sedes" class="btn btn-outline btn-large">Buscar sede cerca de mí</a>
      </div>
      
      <div class="hero-trust">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#BDCA1B" stroke="#BDCA1B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <span>+5 millones de miembros activos en Latinoamérica</span>
      </div>
    </div>
  </section>

  <!-- 4. SOCIAL PROOF -->
  <div class="social-proof bg-primary">
    <div class="container">
      <div class="proof-grid">
        <div class="proof-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          <span>+2.000 sedes en Latinoamérica</span>
        </div>
        <div class="proof-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          <span>+5 millones de miembros</span>
        </div>
        <div class="proof-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          <span>Equipos de última tecnología</span>
        </div>
        <div class="proof-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          <span>Clases grupales incluidas</span>
        </div>
        <div class="proof-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          <span>Sin contratos de permanencia (plan Smart)</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 5. POR QUÉ SMART FIT -->
  <section class="section features">
    <div class="container">
      <h2 class="section-title">Todo lo que necesitas para transformarte, sin pagar de más</h2>
      
      <div class="grid grid-cols-3 features-grid mt-50">
        <div class="feature-card">
          <div class="feature-icon text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 6.5h11"/><path d="M6.5 17.5h11"/><path d="m5 8-1-1v10l1-1"/><path d="m19 8 1-1v10l-1-1"/><path d="M12 6.5v11"/></svg>
          </div>
          <h3>Equipos profesionales</h3>
          <p>Máquinas Technogym y Life Fitness de nivel mundial en cada sede</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3>Donde estés</h3>
          <p>Accede a cualquier sede en Colombia y más de 16 países con tu membresía</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3>Precio justo</h3>
          <p>Gimnasio de alto nivel desde $69.900/mes. Sin letra pequeña</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5b. RETO 30 DÍAS (exclusivo landing) -->
  <section id="reto" class="section challenge bg-dark">
    <div class="container">
      <div class="challenge-grid">
        <div class="challenge-content">
          <span class="section-badge">Solo en esta promoción</span>
          <h2 class="section-title text-white">Reto 30 días: tu transformación con guía real</h2>
          <p class="challenge-lead">
            No es solo inscribirte: te acompañamos con un plan semanal en la app, check-ins con profesores
            y metas claras para que veas progreso en el primer mes.
          </p>
          <ul class="challenge-list">
            <li>Rutina personalizada según tu nivel (principiante o avanzado)</li>
            <li>Recordatorios y seguimiento de asistencia en la Smart Fit App</li>
            <li>Comunidad de apoyo en sede los sábados</li>
          </ul>
          <a href="#planes" class="btn btn-primary mt-30">Unirme al reto gratis</a>
        </div>
        <div class="challenge-stats">
          <div class="stat-card">
            <strong>30</strong>
            <span>días de plan</span>
          </div>
          <div class="stat-card">
            <strong>4</strong>
            <span>semanas guiadas</span>
          </div>
          <div class="stat-card">
            <strong>0</strong>
            <span>costo extra del reto</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. PLANES Y PRECIOS -->
  <section id="planes" class="section planes bg-light">
    <div class="container">
      <h2 class="section-title">Elige el plan que se adapta a ti</h2>
      <p class="section-subtitle">Todos incluyen: primer mes gratis &middot; clases grupales &middot; Smart Spa &middot; App personalizada</p>
      
      <div class="grid grid-cols-3 plans-grid">
        <!-- Plan Fit -->
        <div class="plan-card">
          <h3 class="plan-name">Fit</h3>
          <div class="plan-price">
            <span class="currency">$</span>
            <span class="amount">69.900</span>
            <span class="period">/mes</span>
          </div>
          <ul class="plan-features">
            <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg><span>Acceso al área de musculación y peso libre</span></li>
            <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg><span>Clases grupales</span></li>
            <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg><span>Smart Fit App</span></li>
            <li class="disabled"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18M6 6l12 12"/></svg><span>Acceso a otras sedes de la red</span></li>
            <li class="disabled"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18M6 6l12 12"/></svg><span>Invitar amigos</span></li>
          </ul>
          <a href="#" class="btn btn-dark w-100 mt-auto">Contratar ahora</a>
        </div>
        
        <!-- Plan Black -->
        <div id="beneficios" class="plan-card plan-black">
          <div class="plan-badge">MÁS POPULAR</div>
          <h3 class="plan-name text-primary">Black</h3>
          <div class="plan-price">
            <span class="currency">$</span>
            <span class="amount">89.900</span>
            <span class="period">/mes</span>
          </div>
          <ul class="plan-features">
            <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg><span>Acceso al área de musculación y peso libre</span></li>
            <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg><span>Clases grupales</span></li>
            <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg><span>Smart Fit App</span></li>
            <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg><span>Acceso ilimitado a todas las sedes</span></li>
            <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg><span>Lleva a 5 amigos al mes a entrenar</span></li>
            <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg><span>Sillas de masajes</span></li>
          </ul>
          <a href="#" class="btn btn-primary w-100 mt-auto">Contratar ahora</a>
        </div>

        <!-- Plan Smart -->
        <div class="plan-card">
          <h3 class="plan-name">Smart</h3>
          <div class="plan-price">
            <span class="currency">$</span>
            <span class="amount">79.900</span>
            <span class="period">/mes</span>
          </div>
          <ul class="plan-features">
            <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg><span>Acceso al área de musculación y peso libre</span></li>
            <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg><span>Clases grupales</span></li>
            <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg><span>Smart Fit App</span></li>
            <li class="disabled"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18M6 6l12 12"/></svg><span>Acceso a otras sedes de la red</span></li>
            <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg><span>Sin permanencia</span></li>
          </ul>
          <a href="#" class="btn btn-dark w-100 mt-auto">Contratar ahora</a>
        </div>
      </div>
      
      <div class="plans-guarantee mt-40">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span>Puedes cancelar en cualquier momento en el plan sin permanencia</span>
      </div>
    </div>
  </section>

  <!-- 7. TESTIMONIOS -->
  <section class="section testimonials bg-white">
    <div class="container">
      <h2 class="section-title">Personas reales. Resultados reales.</h2>
      
      <div class="grid grid-cols-3 mt-50">
        <div class="testimonial-card">
          <div class="stars">
            <svg viewBox="0 0 24 24" fill="#BDCA1B" stroke="none" width="20" height="20"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg viewBox="0 0 24 24" fill="#BDCA1B" stroke="none" width="20" height="20"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg viewBox="0 0 24 24" fill="#BDCA1B" stroke="none" width="20" height="20"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg viewBox="0 0 24 24" fill="#BDCA1B" stroke="none" width="20" height="20"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg viewBox="0 0 24 24" fill="#BDCA1B" stroke="none" width="20" height="20"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <p class="quote">"Empecé hace 6 meses y la calidad de las máquinas es increíble. Por el precio que pago, recibo mucho más que en otros gimnasios."</p>
          <div class="author">
            <div class="avatar" style="background-color: #ddd;"></div>
            <div class="author-info">
              <h4>Carlos M.</h4>
              <span>Bogotá &middot; Plan Black</span>
            </div>
          </div>
        </div>
        
        <div class="testimonial-card">
          <div class="stars">
            <svg viewBox="0 0 24 24" fill="#BDCA1B" stroke="none" width="20" height="20"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg viewBox="0 0 24 24" fill="#BDCA1B" stroke="none" width="20" height="20"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg viewBox="0 0 24 24" fill="#BDCA1B" stroke="none" width="20" height="20"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg viewBox="0 0 24 24" fill="#BDCA1B" stroke="none" width="20" height="20"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg viewBox="0 0 24 24" fill="#BDCA1B" stroke="none" width="20" height="20"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <p class="quote">"Lo mejor es poder viajar y seguir entrenando. Voy a Medellín y Cali frecuentemente, y mi membresía funciona en todas las sedes."</p>
          <div class="author">
            <div class="avatar" style="background-color: #ccc;"></div>
            <div class="author-info">
              <h4>Laura G.</h4>
              <span>Medellín &middot; Plan Black</span>
            </div>
          </div>
        </div>

        <div class="testimonial-card">
          <div class="stars">
            <svg viewBox="0 0 24 24" fill="#BDCA1B" stroke="none" width="20" height="20"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg viewBox="0 0 24 24" fill="#BDCA1B" stroke="none" width="20" height="20"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg viewBox="0 0 24 24" fill="#BDCA1B" stroke="none" width="20" height="20"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg viewBox="0 0 24 24" fill="#BDCA1B" stroke="none" width="20" height="20"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg viewBox="0 0 24 24" fill="#BDCA1B" stroke="none" width="20" height="20"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <p class="quote">"Nunca había logrado ser constante hasta que probé las clases grupales. Los profesores te motivan muchísimo."</p>
          <div class="author">
            <div class="avatar" style="background-color: #bbb;"></div>
            <div class="author-info">
              <h4>Andrés P.</h4>
              <span>Cali &middot; Plan Smart</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. CLASES GRUPALES -->
  <section id="clases" class="section classes bg-light">
    <div class="container">
      <h2 class="section-title">Clases que te hacen querer volver todos los días</h2>
      
      <div class="grid grid-cols-4 mt-40">
        <div class="class-card">
          <div class="class-img">
            <img src={smartRumba.src} alt="Clase Smart Rumba" width={smartRumba.width} height={smartRumba.height} loading="lazy" />
          </div>
          <div class="class-info">
            <h3>Smart Rumba</h3>
            <p>45 min &middot; Intensidad alta</p>
            <p class="class-desc">Ritmo, cardio y coordinación con música en vivo en salón.</p>
          </div>
        </div>
        <div class="class-card">
          <div class="class-img">
            <img src={smartCombat.src} alt="Clase Smart Combat" width={smartCombat.width} height={smartCombat.height} loading="lazy" />
          </div>
          <div class="class-info">
            <h3>Smart Combat</h3>
            <p>30-45 min &middot; Intensidad alta</p>
            <p class="class-desc">Artes marciales y cardio para quemar grasa y liberar estrés.</p>
          </div>
        </div>
        <div class="class-card">
          <div class="class-img">
            <img src={smartCycling.src} alt="Clase Smart Cycling" width={smartCycling.width} height={smartCycling.height} loading="lazy" />
          </div>
          <div class="class-info">
            <h3>Smart Cycling</h3>
            <p>45 min &middot; Intensidad alta</p>
            <p class="class-desc">Bici estática al ritmo de la música para resistencia y quema.</p>
          </div>
        </div>
        <div class="class-card">
          <div class="class-img">
            <img src={smartFuncional.src} alt="Clase Smart Funcional" width={smartFuncional.width} height={smartFuncional.height} loading="lazy" />
          </div>
          <div class="class-info">
            <h3>Smart Funcional</h3>
            <p>30-45 min &middot; Intensidad alta</p>
            <p class="class-desc">Fuerza funcional y tonificación para todo el cuerpo.</p>
          </div>
        </div>
      </div>
      
      <div class="text-center mt-40">
        <a href="#" class="btn btn-primary">Ver todos los horarios</a>
      </div>
    </div>
  </section>

  <!-- 8b. COMUNIDAD SMART (exclusivo landing) -->
  <section id="comunidad" class="section community bg-primary">
    <div class="container text-center">
      <span class="section-badge section-badge-dark">Experiencia Smart Fit</span>
      <h2 class="section-title">Comunidad que entrena contigo, dentro y fuera de la sede</h2>
      <p class="section-subtitle community-subtitle">
        Eventos al aire libre, retos entre sedes y sesiones especiales que no encontrarás en una landing genérica.
      </p>
      <div class="grid grid-cols-3 community-grid mt-40">
        <article class="community-card">
          <h3>Smart Weekend</h3>
          <p>Entrenamientos al aire libre: cycling, yoga y funcional en parques y plazas de tu ciudad.</p>
        </article>
        <article class="community-card">
          <h3>Fit Friend</h3>
          <p>Trae un amigo con plan Black y compartan rutina. Más motivación, mejores resultados.</p>
        </article>
        <article class="community-card">
          <h3>Radio Smart Fit</h3>
          <p>Música y energía en sala para que cada serie se sienta como un evento, no una obligación.</p>
        </article>
      </div>
      <a href="#sedes" class="btn btn-dark mt-40">Encuentra tu sede y únete</a>
    </div>
  </section>

  <!-- 8c. PRIMER DÍA (exclusivo landing) -->
  <section id="primer-dia" class="section first-day bg-white">
    <div class="container">
